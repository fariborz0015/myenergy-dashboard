# SQLite file, relative to prisma/schema.prisma
DATABASE_URL="file:./dev.db"
# HTTP port of the API
PORT=4000
# Comma-separated list of allowed browser origins (CORS + Socket.IO).
# Outside NODE_ENV=production any http://localhost:<port> is allowed as well.
WEB_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"
# Incoming telemetry is averaged into buckets of this many seconds before it is stored
TELEMETRY_STORE_BUCKET_S=5
