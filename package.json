{
  "name": "myenergy",
  "private": true,
  "version": "0.1.0",
  "description": "MyEnergy Dashboard: Web Bluetooth dashboard for the YIchu / INFINITY 1000 portable power station",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test:e2e": "turbo run build --filter=@myenergy/web && pnpm --filter @myenergy/web test:e2e",
    "format": "prettier --write .",
    "app:build": "turbo run build --filter=@myenergy/protocol && pnpm --filter @myenergy/web app:build",
    "app:start": "pnpm --filter @myenergy/web app:start"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "~5.9.3"
  }
}
